diff --git a/tests/test_gate.py b/tests/test_gate.py
new file mode 100644
index 0000000..042f590
--- /dev/null
+++ b/tests/test_gate.py
@@ -0,0 +1,56 @@
+import contextlib
+import io
+import unittest
+from unittest import mock
+
+import gate
+
+
+class GateTests(unittest.TestCase):
+    def test_pass_is_emitted_only_when_both_checks_succeed(self):
+        with mock.patch(
+            "gate.subprocess.run",
+            side_effect=[
+                mock.Mock(returncode=0),
+                mock.Mock(returncode=0),
+            ],
+        ) as run:
+            output = io.StringIO()
+            with contextlib.redirect_stdout(output):
+                result = gate.main()
+
+        self.assertEqual(result, 0)
+        self.assertEqual(run.call_count, 2)
+        self.assertEqual(output.getvalue(), "PASS\n")
+
+    def test_child_failure_propagates_after_all_checks_finish(self):
+        with mock.patch(
+            "gate.subprocess.run",
+            side_effect=[
+                mock.Mock(returncode=7),
+                mock.Mock(returncode=0),
+            ],
+        ) as run:
+            output = io.StringIO()
+            with contextlib.redirect_stdout(output):
+                result = gate.main()
+
+        self.assertEqual(result, 7)
+        self.assertEqual(run.call_count, 2)
+        self.assertEqual(output.getvalue(), "")
+
+    def test_post_assertion_failure_propagates(self):
+        with mock.patch(
+            "gate.subprocess.run",
+            side_effect=[
+                mock.Mock(returncode=0),
+                mock.Mock(returncode=1),
+            ],
+        ) as run:
+            output = io.StringIO()
+            with contextlib.redirect_stdout(output):
+                result = gate.main()
+
+        self.assertEqual(result, 1)
+        self.assertEqual(run.call_count, 2)
+        self.assertEqual(output.getvalue(), "")
